# SHADOWGLASS Frontend Environment Variables
# Copy this file to .env.local and configure values

# =============================================================================
# REQUIRED: API Configuration
# =============================================================================

# API base URL (required in production)
# Development default: /api (proxies to backend)
# Production example: https://api.shadowglass.example.com
NEXT_PUBLIC_API_URL=/api

# =============================================================================
# OPTIONAL: Session Configuration
# =============================================================================

# Session timeout in milliseconds (default: 1800000 = 30 minutes)
# Minimum: 60000 (1 minute)
# NEXT_PUBLIC_SESSION_TIMEOUT_MS=1800000

# Maximum API request retries (default: 3, range: 0-10)
# NEXT_PUBLIC_MAX_RETRIES=3

# API request timeout in milliseconds (default: 30000 = 30 seconds)
# Minimum: 5000 (5 seconds)
# NEXT_PUBLIC_REQUEST_TIMEOUT_MS=30000

# =============================================================================
# OPTIONAL: Feature Flags
# =============================================================================

# Enable debug logging (development only)
# NEXT_PUBLIC_DEBUG=false

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# 1. NEVER commit .env.local or .env files with real values
# 2. Use different API URLs for development/staging/production
# 3. In production, ensure API uses HTTPS
# 4. Configure CORS on the API to allow only trusted origins
# 5. Use secure cookies for authentication tokens in production
#
# =============================================================================
